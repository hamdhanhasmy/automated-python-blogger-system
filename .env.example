# Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Blogger API Credentials
BLOGGER_BLOG_ID="YOUR_BLOGGER_BLOG_ID"
BLOGGER_CLIENT_ID="YOUR_BLOGGER_CLIENT_ID"
BLOGGER_CLIENT_SECRET="YOUR_BLOGGER_CLIENT_SECRET"
BLOGGER_REFRESH_TOKEN="YOUR_BLOGGER_REFRESH_TOKEN"

# RSS Feed URLs (comma-separated list)
RSS_FEEDS=https://news.google.com/rss,https://feeds.bbci.co.uk/news/technology/rss.xml

# System Configuration
ALLOWED_CATEGORIES=Technology, World News, Business & Economy, Science & Innovation, Politics, Entertainment, Health & Lifestyle
MAX_ARTICLES_PER_RUN=1
GEMINI_MODEL=gemini-2.5-flash
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
